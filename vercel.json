{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "program-two",
          "format": "url",
          "env": "PROGRAM_TWO_URL"
        },
        {
          "type": "service",
          "service": "program-five",
          "format": "url",
          "env": "PROGRAM_FIVE_URL"
        },
        {
          "type": "service",
          "service": "program-eight",
          "format": "url",
          "env": "PROGRAM_EIGHT_URL"
        },
        {
          "type": "service",
          "service": "program-nine",
          "format": "url",
          "env": "PROGRAM_NINE_URL"
        },
        {
          "type": "service",
          "service": "program-ten",
          "format": "url",
          "env": "PROGRAM_TEN_URL"
        }
      ]
    },
    "program-two": {
      "root": "Program-2",
      "framework": "express"
    },
    "program-five": {
      "root": "Program-5",
      "framework": "express"
    },
    "program-eight": {
      "root": "Program-8",
      "framework": "express"
    },
    "program-nine": {
      "root": "Program-9",
      "framework": "express"
    },
    "program-ten": {
      "root": "Program-10",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
